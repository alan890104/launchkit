{
  "$schema": "https://schema.railpack.com",
  "caches": {
    "cargo_git": {
      "directory": "/root/.cargo/git",
      "type": "shared"
    },
    "cargo_registry": {
      "directory": "/root/.cargo/registry",
      "type": "shared"
    },
    "cargo_target": {
      "directory": "target",
      "type": "shared"
    }
  },
  "deploy": {
    "base": {
      "image": "ghcr.io/railwayapp/railpack-runtime:mise-2026.3.17"
    },
    "inputs": [
      {
        "exclude": [
          "target"
        ],
        "include": [
          "."
        ],
        "step": "build"
      }
    ],
    "startCommand": "./bin/poc-rust-api",
    "variables": {
      "ROCKET_ADDRESS": "0.0.0.0"
    }
  },
  "steps": [
    {
      "assets": {
        "generated-mise-toml": "[tools]\n  rust = \"1.84.0\"\n\n[settings]\n  idiomatic_version_file_enable_tools = [\"python\", \"node\", \"ruby\", \"elixir\", \"go\", \"java\", \"yarn\"]\n  install_before = \"14d\"\n  paranoid = true\n  trusted_config_paths = [\"/app\"]\n  [settings.node]\n    verify = false\n"
      },
      "commands": [
        {
          "path": "/mise/shims"
        },
        {
          "customName": "create mise config",
          "name": "generated-mise-toml",
          "path": "/etc/mise/config.toml"
        },
        {
          "cmd": "mise install",
          "customName": "install mise packages: rust"
        }
      ],
      "inputs": [
        {
          "image": "ghcr.io/railwayapp/railpack-builder:mise-2026.3.17"
        }
      ],
      "name": "packages:mise",
      "variables": {
        "MISE_CACHE_DIR": "/mise/cache",
        "MISE_CONFIG_DIR": "/mise",
        "MISE_DATA_DIR": "/mise",
        "MISE_INSTALLS_DIR": "/mise/installs",
        "MISE_SHIMS_DIR": "/mise/shims"
      }
    },
    {
      "assets": {
        "main.rs": "fn main() { }"
      },
      "caches": [
        "cargo_registry",
        "cargo_git"
      ],
      "commands": [
        {
          "dest": ".",
          "src": "Cargo.toml*"
        },
        {
          "dest": ".",
          "src": "Cargo.lock*"
        },
        {
          "cmd": "mkdir -p src"
        },
        {
          "customName": "compile dependencies",
          "name": "main.rs",
          "path": "src/main.rs"
        },
        {
          "cmd": "cargo build --release"
        },
        {
          "cmd": "rm -rf src target/release/poc-rust-api*"
        }
      ],
      "inputs": [
        {
          "step": "packages:mise"
        }
      ],
      "name": "install",
      "secrets": [
        "*"
      ]
    },
    {
      "caches": [
        "cargo_target"
      ],
      "commands": [
        {
          "cmd": "mkdir -p bin"
        },
        {
          "cmd": "cargo build --release"
        },
        {
          "cmd": "cp target/release/poc-rust-api bin"
        }
      ],
      "inputs": [
        {
          "step": "packages:mise"
        },
        {
          "exclude": [
            "/app/"
          ],
          "step": "install"
        },
        {
          "include": [
            "."
          ],
          "local": true
        }
      ],
      "name": "build",
      "secrets": [
        "*"
      ]
    }
  ]
}