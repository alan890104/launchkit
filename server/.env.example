PORT=8080
ENV=development
VERSION=0.1.0

# Database (Neon Postgres in prod, local Postgres for dev)
DATABASE_URL=postgresql://launchkit:launchkit@localhost:5432/launchkit?sslmode=disable

# Server identity
BASE_URL=http://localhost:8080

# Build mode: "local" (open-source, uses Docker on this machine) or "cloud" (BuildKit VM / Cloud Build)
# Default is "local" — no remote build infra needed for the open-source tier.
BUILD_MODE=local
DOCKER_SOCKET=unix:///var/run/docker.sock   # used when BUILD_MODE=local

# GCP (required for deploy features)
GCP_PROJECT_ID=
GCP_REGION=us-east4
ARTIFACT_REGISTRY_REPO=       # default: {region}-docker.pkg.dev/{project}/user-images
GOOGLE_APPLICATION_CREDENTIALS=~/.config/launchkit/sa-key.json

# Cloud build mode only (BUILD_MODE=cloud) — not needed for local mode
GCS_BUILD_BUCKET=             # default: {project}-launchkit-builds
BUILDKIT_ADDR=                # e.g. tcp://10.128.0.x:1234
BUILDKIT_INSTANCE=launchkit-buildkit
BUILDKIT_ZONE=                # default: {region}-c

# Neon — managed Postgres for user projects (https://console.neon.tech → API Keys)
NEON_API_KEY=

# Upstash — managed Redis for user projects (https://console.upstash.com → API Keys)
UPSTASH_EMAIL=
UPSTASH_API_KEY=

# Cloudflare — Pages for static frontends (https://dash.cloudflare.com)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Resend — transactional email for user projects (https://resend.com/api-keys)
RESEND_API_KEY=

# Name.com — domain registration (https://www.name.com/reseller)
# Set NAMECOM_SANDBOX=true for development (uses api.dev.name.com)
NAMECOM_API_USER=
NAMECOM_API_TOKEN=
NAMECOM_SANDBOX=true

# Firebase — authentication for web dashboard (required in production/staging)
FIREBASE_PROJECT_ID=       # GCP project ID with Firebase enabled (same as GCP_PROJECT_ID if using GCP)

# Secret encryption — AES-256-GCM key for secrets at rest.
# Generate: openssl rand -hex 32
# Required in production. If unset, secrets are stored as plaintext (dev only).
SECRET_ENCRYPTION_KEY=

# CORS — comma-separated list of allowed browser origins.
# Defaults to "*" (wildcard) if unset. Set to your dashboard domain(s) in production.
# Example: ALLOWED_ORIGINS=https://app.launchkit.dev,https://launchkit.dev
ALLOWED_ORIGINS=

# GitHub — push-to-deploy webhook integration (optional)
# Personal Access Token or GitHub App token for downloading private repo source
GITHUB_TOKEN=

# LaunchKit-internal Redis cache (Upstash REST) — optional
# Used for distributed API key validation cache across multiple server instances
# Without this, each instance does a DB lookup per authenticated request (fine for single-instance)
LAUNCHKIT_REDIS_URL=
LAUNCHKIT_REDIS_TOKEN=

# Dev shortcut — set any string as a static API key for local development.
# Requests with "Authorization: Bearer <this value>" are auth'd as dev-user.
# NEVER set in production.
LAUNCHKIT_DEV_KEY=

# Operation timeouts (optional — rarely need changing from defaults)
# BUILDKIT_START_TIMEOUT=90s
# BUILDKIT_IDLE_TIMEOUT=30m
# BUILDKIT_CHECK_INTERVAL=5m
# CLOUD_BUILD_TIMEOUT=10m
# DEPLOY_WORKER_TIMEOUT=15m
# ECS_STABILIZE_TIMEOUT=5m
